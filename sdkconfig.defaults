CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=32
CONFIG_FATFS_IMMEDIATE_FSYNC=y
CONFIG_FATFS_TIMEOUT_MS=10000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Retain all runtime assertion checks and panic/recovery, while omitting the
# repeated file/expression strings. Crash backtraces remain symbolizable.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Reclaim TLS record buffers between reads/writes instead of retaining both
# for the whole connection. Keep the full 16-KiB receive-record compatibility.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=3

# POS hosts an explicit LAN HTTP session, never a TLS server. Keep validated
# HTTPS clients while leaving unused server handshakes out of resident flash.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Use modern ECDHE with RSA/ECDSA authentication; retain P-256/384/521
# and X25519. Drop unused legacy/static suites and curve tables.
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n

# POS joins existing Wi-Fi networks; no hotspot/AP interface is exposed.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# POS configures IPv4 STA/DHCP and IPv4-only LAN sessions. No IPv6 netif is
# configured; omit its unused protocol machinery, keeping both OTA slots.
CONFIG_LWIP_IPV6=n
